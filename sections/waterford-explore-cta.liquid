{%- comment -%}
  Reusable “Explore exclusive wines / older vintages” CTA for collection pages.
{%- endcomment -%}

{{ 'waterford-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading | default: 'Explore exclusive wines'
  assign subheading = section.settings.subheading | default: 'Discover older vintages and library releases.'
  assign cta_label = section.settings.cta_label | default: 'Explore now'
  assign cta_link = section.settings.cta_link
  assign image = section.settings.image
-%}

<section
  class="wf-explore-cta{% if image != blank %} wf-explore-cta--has-image{% endif %}"
  {{ section.shopify_attributes }}
>
  {%- if image != blank -%}
    <div class="wf-explore-cta__media" aria-hidden="true">
      {{
        image
        | image_url: width: 2000
        | image_tag:
          widths: '800, 1200, 1600, 2000',
          sizes: '100vw',
          loading: 'lazy',
          class: 'wf-explore-cta__img',
          alt: ''
      }}
    </div>
  {%- endif -%}
  <div class="wf-explore-cta__overlay" aria-hidden="true"></div>
  <div class="wf-explore-cta__content">
    {%- if heading != blank -%}
      <h2 class="wf-explore-cta__title serif">{{ heading }}</h2>
    {%- endif -%}
    {%- if subheading != blank -%}
      <p class="wf-explore-cta__text">{{ subheading }}</p>
    {%- endif -%}
    {%- if cta_label != blank and cta_link != blank -%}
      <a class="wf-explore-cta__btn" href="{{ cta_link }}">{{ cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "WF Explore CTA",
  "tag": "section",
  "class": "section-waterford-explore-cta",
  "enabled_on": { "templates": ["collection", "page"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore exclusive wines"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Supporting text",
      "default": "Discover older vintages and library releases."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Explore now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "WF Explore CTA" }]
}
{% endschema %}
