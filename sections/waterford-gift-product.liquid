{%- comment -%}
  Gift product PDP — informational only. No purchase forms, qty, ATC, or subscriptions.
{%- endcomment -%}

{{ 'waterford-product.css' | asset_url | stylesheet_tag }}
{{ 'waterford-collection.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'waterford-product.js' | asset_url }}"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

{%- liquid
  assign inclusions_heading = section.settings.inclusions_heading | default: 'Gift Contents'
-%}

<div class="wf-pdp wf-pdp--gift" data-wf-pdp {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="breadcrumb">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      &nbsp;&rsaquo;&nbsp;
      <a href="/collections/gifting">Gifting</a>
      &nbsp;&rsaquo;&nbsp;
      <span>{{ product.title }}</span>
    </div>

    <section class="pdp-top">
      {% render 'wf-pdp-gallery', product: product, block: section %}

      <div class="pdp-info">
        <h1 class="serif pdp-title">{% render 'wf-product-display-title', product: product %}</h1>

        {%- if product.description != blank -%}
          <div class="pdp-tagline wf-gift-description rte">{{ product.description }}</div>
        {%- endif -%}

        {% render 'waterford-inclusions',
          product: product,
          heading: inclusions_heading,
          fallback_html: section.settings.inclusions_fallback
        %}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "WF Gift product",
  "tag": "section",
  "class": "section-waterford-gift-product",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Informational gift page — no Add to Cart. Inclusions pull from product metafield custom.inclusions (rich text / multi-line)."
    },
    {
      "type": "text",
      "id": "inclusions_heading",
      "label": "Inclusions heading",
      "default": "Gift Contents"
    },
    {
      "type": "richtext",
      "id": "inclusions_fallback",
      "label": "Inclusions fallback",
      "info": "Used only when the product has no custom.inclusions metafield."
    }
  ],
  "presets": [{ "name": "WF Gift product" }]
}
{% endschema %}
