{%- comment -%}
  Page hero for vouchers (and similar pages) — matches collection hero look.
{%- endcomment -%}

{{ 'waterford-collection.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

{%- liquid
  assign hero_image = section.settings.image
  assign hero_image_mobile = section.settings.image_mobile
  assign heading = section.settings.heading | default: page.title
  assign blurb = section.settings.blurb
  assign has_hero_image = false
  if hero_image != blank
    assign has_hero_image = true
  endif
-%}

<section
  class="wf-collection wf-hero{% if has_hero_image %} wf-hero--has-image{% endif %}"
  {% if has_hero_image %}
    style="--wf-hero-image: url('{{ hero_image | image_url: width: 2400 }}');"
  {% endif %}
  {{ section.shopify_attributes }}
>
  {%- if has_hero_image -%}
    <div class="wf-hero__media">
      {%- if hero_image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ hero_image_mobile | image_url: width: 1200 }}">
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              widths: '800, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'wf-hero__img',
              alt: heading
          }}
        </picture>
      {%- else -%}
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'wf-hero__img',
            alt: heading
        }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="wf-hero__overlay" aria-hidden="true"></div>
  <div class="wf-hero__content">
    {%- if heading != blank -%}
      <h1 class="wf-hero__title serif">{{ heading }}</h1>
    {%- endif -%}
    {%- if blurb != blank -%}
      <div class="wf-hero__blurb rte">{{ blurb }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "WF Page hero",
  "tag": "section",
  "class": "section-waterford-page-hero",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Vouchers" },
    { "type": "richtext", "id": "blurb", "label": "Introductory copy" }
  ],
  "presets": [{ "name": "WF Page hero" }]
}
{% endschema %}
