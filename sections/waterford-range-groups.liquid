{%- comment -%}
  Ranges page — group products under editable range headings + blurbs.
{%- endcomment -%}

{{ 'waterford-collection.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'waterford-collection.js' | asset_url }}"></script>

<div class="wf-collection wf-range-groups" {{ section.shopify_attributes }}>
  <div class="wf-wrap">
    {%- for block in section.blocks -%}
      {%- if block.type == 'range_group' -%}
        <section class="wf-range-group" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="wf-range-group__title serif">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.blurb != blank -%}
            <div class="wf-range-group__blurb">{{ block.settings.blurb }}</div>
          {%- endif -%}
          {%- if block.settings.products != blank and block.settings.products.size > 0 -%}
            <ul class="wf-grid">
              {%- for product in block.settings.products -%}
                <li>{% render 'waterford-product-card', product: product, index: forloop.index0 %}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "WF Range groups",
  "tag": "section",
  "class": "section-waterford-range-groups",
  "enabled_on": { "templates": ["collection", "page"] },
  "settings": [],
  "blocks": [
    {
      "type": "range_group",
      "name": "Range group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Range heading", "default": "Estate" },
        { "type": "richtext", "id": "blurb", "label": "Short blurb" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 24 }
      ]
    }
  ],
  "presets": [
    {
      "name": "WF Range groups",
      "blocks": [
        { "type": "range_group", "settings": { "heading": "Estate" } },
        { "type": "range_group", "settings": { "heading": "Waterford Range" } }
      ]
    }
  ]
}
{% endschema %}
