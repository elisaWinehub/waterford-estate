{%- comment -%}
  Theme-editor managed voucher cards (external DinePlan links — not Shopify products).
{%- endcomment -%}

{{ 'waterford-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cols = section.settings.columns | default: '3'
-%}

<section class="wf-collection wf-voucher-grid" {{ section.shopify_attributes }}>
  <div class="wf-wrap">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="wf-page-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="serif wf-voucher-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="wf-voucher-grid__list wf-voucher-grid__list--cols-{{ cols }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'voucher' -%}
            <li class="wf-voucher-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="wf-voucher-card__photo">
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      widths: '400, 600, 800',
                      sizes: '(min-width: 901px) 25vw, (min-width: 601px) 50vw, 100vw',
                      loading: 'lazy',
                      alt: block.settings.title
                  }}
                </div>
              {%- endif -%}
              <div class="wf-voucher-card__body">
                {%- if block.settings.title != blank -%}
                  <h3 class="wf-voucher-card__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.blurb != blank -%}
                  <div class="wf-voucher-card__blurb">{{ block.settings.blurb }}</div>
                {%- endif -%}
                {%- if block.settings.price_display != blank -%}
                  <div class="wf-voucher-card__price">{{ block.settings.price_display }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                  <a
                    class="wf-voucher-card__btn"
                    href="{{ block.settings.button_url }}"
                    {% if block.settings.button_url contains 'http' %}target="_blank" rel="noopener"{% endif %}
                  >
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "WF Voucher grid",
  "tag": "section",
  "class": "section-waterford-voucher-grid",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift vouchers" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "voucher",
      "name": "Voucher",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Waterford Estate Gift Voucher" },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Blurb",
          "default": "The perfect gift for a memorable Waterford Estate experience."
        },
        {
          "type": "text",
          "id": "price_display",
          "label": "Price / value display",
          "default": "From R500",
          "info": "Display text only — not connected to Shopify pricing."
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy Voucher" },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL (DinePlan)",
          "info": "External DinePlan (or other) checkout link."
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "WF Voucher grid",
      "blocks": [
        { "type": "voucher" },
        { "type": "voucher" },
        { "type": "voucher" }
      ]
    }
  ]
}
{% endschema %}
